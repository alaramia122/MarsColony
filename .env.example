# MarsColony local configuration
# PostgreSQL
POSTGRES_PASSWORD=replace-with-a-local-password

# AI is disabled until a provider is configured.
MARS_AI_PROVIDER=disabled
MARS_AI_TIMEOUT_SECONDS=45

# Native Yandex AI Studio adapter
# Create a service-account API key with yc.ai.foundationModels.execute scope.
# The service account needs ai.languageModels.user on the selected folder.
# API keys are paid by consumption; verify current pricing and quotas in AI Studio.
# MARS_AI_PROVIDER=yandex_ai_studio
MARS_AI_YANDEX_API_KEY=
MARS_AI_YANDEX_FOLDER_ID=
MARS_AI_YANDEX_MODEL=yandexgpt/latest

# Alternative: OpenAI Chat Completions-compatible provider
# MARS_AI_PROVIDER=openai_compatible
MARS_AI_BASE_URL=
MARS_AI_API_KEY=
MARS_AI_MODEL=

# Multi-provider registry (takes precedence over legacy single-provider settings).
# JSON profiles reference secrets by environment-variable name; never put API keys in this JSON.
# MARS_AI_PROVIDERS={"yandex":{"type":"yandex_ai_studio","api_key_env":"MARS_YANDEX_KEY","folder_id":"your-folder","model":"yandexgpt/latest"},"ollama":{"type":"openai_compatible","base_url":"http://ollama:11434/v1","model":"qwen2.5:7b","requires_api_key":false,"capabilities":{"json_object":false}},"openrouter":{"type":"openai_compatible","base_url":"https://openrouter.ai/api/v1","api_key_env":"OPENROUTER_API_KEY","model":"provider/model"}}
# MARS_AI_TASK_ROUTING={"project_proposal":["yandex","openrouter"],"project_clarification":["yandex"],"briefing":["ollama","yandex"],"scenario_event":["openrouter","yandex"],"knowledge_entity":["yandex"]}
